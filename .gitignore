# Built binary names (release tarballs are produced by goreleaser into ./dist)
/teploy-dash
/teploy-ui
*.exe
*.test

# Goreleaser output
/dist/

# Local data
/var/teploy-dash/

# Runtime credential stores accidentally written into the source tree by a
# test run from the repo root (F069) — tests must use t.TempDir(); this
# entry only keeps the accidental artifact out of tracking.
internal/server/users.json
internal/server/auth.json
internal/server/mcp-tokens.json

# Environment
.env

# Private destination overlays (per-infra, never committed)
teploy.*.yml

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Claude Code worktrees + session state — should never be committed
.claude/

# Private notes — local only, never committed
/_internal/
/INTERNAL.md

# ci/ node tooling installs (ci/package-lock.json IS committed)
/ci/node_modules/
