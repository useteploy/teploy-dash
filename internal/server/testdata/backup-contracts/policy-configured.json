{
  "machine_interface": 2,
  "host": "192.0.2.10",
  "configured": true,
  "path": "/etc/teploy/backup-policy.json",
  "interval": "1h",
  "cron": "37 * * * *",
  "retention": {
    "keep_last": 3,
    "keep_daily": 7,
    "keep_weekly": 4,
    "keep_monthly": 12,
    "max_age_days": 2
