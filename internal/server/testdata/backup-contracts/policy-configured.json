  "excludes": [
    "blog/volumes"
  ],
  "adopted": [
    {
      "container": "wordpress-shared-mysql",
      "engine": "mysql",
      "databases": "all"
    },
    {
      "container": "omni_postgres",
      "databases": [
        "omni"
      ]
    }
  ],
  "volumes": true,
  "volume_max_gb": 20,
  "heartbeat_count": 1,
  "heartbeat_hosts": [
    "https://dash.example.internal"
  ],
  "recipient": "age1lggyhqrw2nlhcxprm67z43rta597azn8gknawjehu9d9dl0jq3yqqvfafg",
